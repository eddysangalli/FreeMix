index 0000000..26a2dcb
--- /dev/null
+++ b/plugins/obs-color-monitor/src/scope-widget.cpp
@@ -0,0 +1,676 @@
+#include <obs-module.h>
+#include <obs.h>
+#include <obs-frontend-api.h>
+#include <util/threading.h>
+#include <util/dstr.hpp>
+#include <string>
+#include <algorithm>
+#include <QMenu>
+#include <QAction>
+#include <QMouseEvent>
