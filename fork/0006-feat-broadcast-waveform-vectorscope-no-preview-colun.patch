diff --git a/plugins/obs-color-monitor/data/falsecolor.effect b/plugins/obs-color-monitor/data/falsecolor.effect
new file mode 100644
index 0000000..910e141
--- /dev/null
+++ b/plugins/obs-color-monitor/data/falsecolor.effect
@@ -0,0 +1,112 @@
+uniform float4x4 ViewProj;
+uniform texture2d image;
+uniform bool use_lut;
+uniform texture2d lut;
+
+sampler_state def_sampler {
+	Filter   = Linear;
+	AddressU = Clamp;
+	AddressV = Clamp;
+};
+
+sampler_state lut_sampler {
+	Filter   = Point;
+	AddressU = Clamp;
+	AddressV = Clamp;
+};
+
+struct VertInOut {
+	float4 pos : POSITION;
+	float2 uv  : TEXCOORD0;
+};
+
+VertInOut VSDefault(VertInOut vert_in)
+{
+	VertInOut vert_out;
+	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
+	vert_out.uv  = vert_in.uv;
+	return vert_out;
+}
+
+float4 PSDrawFalseColor601(VertInOut vert_in) : TARGET
+{
+	float4 rgba = image.Sample(def_sampler, vert_in.uv);
+	float y = dot(rgba.xyz, float3(0.299000, 0.587000, 0.114000));
+
+	if (use_lut)
+		return lut.Sample(lut_sampler, float2(y, 0.5));
+	else if (y < 0.02)
+		return float4(0.85, 0.22, 1.0, 1.0); // bright purple
+	else if (y < 0.10)
+		return float4(0.0, 0.0, 1.0, 1.0); // blue
+	else if (y < 0.20)
+		return float4(0.33, 0.55, 1.0, 1.0); // light blue
+	else if (y < 0.42)
+		return float4(0.3, 0.3, 0.3, 1.0); // dark grey
+	else if (y < 0.48)
+		return float4(0.6, 1.0, 0.0, 1.0); // green
+	else if (y < 0.52)
+		return float4(0.5, 0.5, 0.5, 1.0); // medium grey
+	else if (y < 0.58)
+		return float4(0.95, 0.62, 0.62, 1.0); // pink
+	else if (y < 0.78)
+		return float4(0.7, 0.7, 0.7, 1.0); // light grey
+	else if (y < 0.84)
+		return float4(0.7, 0.7, 0.0, 1.0); // dark yellow
+	else if (y < 0.94)
+		return float4(1.0, 1.0, 0.0, 1.0); // yellow
+	else if (y < 1.00)
+		return float4(0.9, 0.5, 0.0, 1.0); // orange
+	else
+		return float4(0.9, 0.2, 0.0, 1.0); // red
+}
+
+float4 PSDrawFalseColor709(VertInOut vert_in) : TARGET
+{
+	float4 rgba = image.Sample(def_sampler, vert_in.uv);
+	float y = dot(rgba.xyz, float3(0.212600, 0.715200, 0.072200));
+
+	if (use_lut)
+		return lut.Sample(lut_sampler, float2(y, 0.5));
+	else if (y < 0.02)
+		return float4(0.85, 0.22, 1.0, 1.0); // bright purple
+	else if (y < 0.10)
+		return float4(0.0, 0.0, 1.0, 1.0); // blue
+	else if (y < 0.20)
+		return float4(0.33, 0.55, 1.0, 1.0); // light blue
+	else if (y < 0.42)
+		return float4(0.3, 0.3, 0.3, 1.0); // dark grey
+	else if (y < 0.48)
+		return float4(0.6, 1.0, 0.0, 1.0); // green
+	else if (y < 0.52)
+		return float4(0.5, 0.5, 0.5, 1.0); // medium grey
+	else if (y < 0.58)
+		return float4(0.95, 0.62, 0.62, 1.0); // pink
+	else if (y < 0.78)
+		return float4(0.7, 0.7, 0.7, 1.0); // light grey
+	else if (y < 0.84)
+		return float4(0.7, 0.7, 0.0, 1.0); // dark yellow
+	else if (y < 0.94)
+		return float4(1.0, 1.0, 0.0, 1.0); // yellow
+	else if (y < 1.00)
+		return float4(0.9, 0.5, 0.0, 1.0); // orange
+	else
+		return float4(0.9, 0.2, 0.0, 1.0); // red
+}
+
+technique DrawFalseColor601
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawFalseColor601(vert_in);
+	}
+}
+technique DrawFalseColor709
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawFalseColor709(vert_in);
+	}
+}
diff --git a/plugins/obs-color-monitor/data/focuspeaking.effect b/plugins/obs-color-monitor/data/focuspeaking.effect
new file mode 100644
index 0000000..fd5d1d6
--- /dev/null
+++ b/plugins/obs-color-monitor/data/focuspeaking.effect
@@ -0,0 +1,57 @@
+uniform float4x4 ViewProj;
+uniform texture2d image;
+uniform float2 dxy;
+uniform float4 peaking_color;
+uniform float peaking_threshold;
+
+sampler_state def_sampler {
+	Filter   = Linear;
+	AddressU = Clamp;
+	AddressV = Clamp;
+};
+
+struct VertInOut {
+	float4 pos : POSITION;
+	float2 uv  : TEXCOORD0;
+};
+
+VertInOut VSDefault(VertInOut vert_in)
+{
+	VertInOut vert_out;
+	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
+	vert_out.uv  = vert_in.uv;
+	return vert_out;
+}
+
+float4 PSDrawFocusPeaking(VertInOut vert_in) : TARGET
+{
+	float2 dx = float2(dxy.x, 0.0);
+	float2 dy = float2(0.0, dxy.y);
+	float4 rgba = image.Sample(def_sampler, vert_in.uv);
+	float3 rgb1 = image.Sample(def_sampler, vert_in.uv + dx).xyz;
+	float3 rgb2 = image.Sample(def_sampler, vert_in.uv + dy).xyz;
+	float3 rgb3 = image.Sample(def_sampler, vert_in.uv - dx).xyz;
+	float3 rgb4 = image.Sample(def_sampler, vert_in.uv - dy).xyz;
+
+	float3 drgb = (
+		abs(rgb1 - rgba.xyz) +
+		abs(rgb2 - rgba.xyz) +
+		abs(rgb3 - rgba.xyz) +
+		abs(rgb4 - rgba.xyz) ) * 0.25;
+
+	float d = (drgb.x + drgb.y + drgb.z) * 0.3333;
+
+	if (d < peaking_threshold)
+		return rgba;
+	else
+		return peaking_color;
+}
+
+technique DrawFocusPeaking
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawFocusPeaking(vert_in);
+	}
+}
diff --git a/plugins/obs-color-monitor/data/histogram.effect b/plugins/obs-color-monitor/data/histogram.effect
new file mode 100644
index 0000000..303b3b7
--- /dev/null
+++ b/plugins/obs-color-monitor/data/histogram.effect
@@ -0,0 +1,130 @@
+uniform float4x4 ViewProj;
+uniform texture2d image;
+uniform float3 hi_max;
+uniform float4x4 color = {
+	1.00, 0.41, 0.41, 0.0,
+	0.00, 1.00, 0.00, 0.0,
+	0.53, 0.53, 1.00, 0.0,
+	0.00, 0.00, 0.00, 1.0
+};
+
+sampler_state def_sampler {
+	Filter   = Point;
+	AddressU = Repeat;
+	AddressV = Clamp;
+};
+
+struct VertInOut {
+	float4 pos : POSITION;
+	float2 uv  : TEXCOORD0;
+};
+
+VertInOut VSDefault(VertInOut vert_in)
+{
+	VertInOut vert_out;
+	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
+	vert_out.uv  = vert_in.uv;
+	return vert_out;
+}
+
+float4 PSDrawOverlay(VertInOut vert_in) : TARGET
+{
+	float4 rgb;
+	rgb.xyz = image.Sample(def_sampler, float2(vert_in.uv.x, 0.5)).xyz;
+	if (rgb.x >= (1-vert_in.uv.y) * hi_max.x) rgb.x=1.0; else rgb.x=0.0;
+	if (rgb.y >= (1-vert_in.uv.y) * hi_max.y) rgb.y=1.0; else rgb.y=0.0;
+	if (rgb.z >= (1-vert_in.uv.y) * hi_max.z) rgb.z=1.0; else rgb.z=0.0;
+	rgb.a = 1.0;
+	return rgb;
+}
+
+float4 PSDrawStack(VertInOut vert_in) : TARGET
+{
+	int i = int(vert_in.uv.y * 3);
+	float v = vert_in.uv.y * 3 - i;
+	float r = image.Sample(def_sampler, float2(vert_in.uv.x, 0.5))[i];
+	if (r >= (1-v) * hi_max[i]) r=1.0; else r=0.0;
+	return float4(color[i].xyz*r, 1.0);
+}
+
+float4 PSDrawParade(VertInOut vert_in) : TARGET
+{
+	int i = int(vert_in.uv.x * 3);
+	float r = image.Sample(def_sampler, float2(vert_in.uv.x*3, 0.5))[i];
+	if (r >= (1-vert_in.uv.y) * hi_max[i]) r=1.0; else r=0.0;
+	return float4(color[i].xyz*r, 1.0);
+}
+
+float4 PSDrawStackUV(VertInOut vert_in) : TARGET
+{
+	int i;
+	float v;
+	if (vert_in.uv.y < 0.5) {
+		i = 0;
+		v = vert_in.uv.y * 2;
+	}
+	else {
+		i = 2;
+		v = vert_in.uv.y * 2 - 1;
+	}
+	float r = image.Sample(def_sampler, float2(vert_in.uv.x, 0.5))[i];
+	if (r >= (1-v) * hi_max[i]) r=1.0; else r=0.0;
+	return float4(color[i].xyz*r, 1.0);
+}
+
+float4 PSDrawParadeUV(VertInOut vert_in) : TARGET
+{
+	int i;
+	if (vert_in.uv.x < 0.5)
+		i = 0;
+	else
+		i = 2;
+	float r = image.Sample(def_sampler, float2(vert_in.uv.x*2, 0.5))[i];
+	if (r >= (1-vert_in.uv.y) * hi_max[i]) r=1.0; else r=0.0;
+	return float4(color[i].xyz*r, 1.0);
+}
+
+technique DrawOverlay
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawOverlay(vert_in);
+	}
+}
+
+technique DrawStack
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawStack(vert_in);
+	}
+}
+
+technique DrawParade
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawParade(vert_in);
+	}
+}
+
+technique DrawStackUV
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawStackUV(vert_in);
+	}
+}
+
+technique DrawParadeUV
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSDrawParadeUV(vert_in);
+	}
+}
