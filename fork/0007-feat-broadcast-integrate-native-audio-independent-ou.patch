+#include "FreeMixGlobalHotkeys.hpp"
+#include "OBSBasic.hpp"
+#include "../../plugins/obs-websocket/lib/obs-websocket-api.h"
+#include <obs-frontend-api.h>
+#include <obs-hotkey.h>
+#include <obs-interaction.h>
