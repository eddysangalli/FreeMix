+		const char* p_url_address = NULL
+	);
+#endif // NDILIB_CPP_DEFAULT_CONSTRUCTORS
+} NDIlib_send_listener_create_t;
+
+// Create an instance of the sender listener. This will return NULL if it fails to create the listener.
