+struct freemix_raw_video_rebind {
+	video_t *old_video;
+	DARRAY(obs_output_t *) outputs;
+};
+
+static bool freemix_detach_raw_video(void *param, obs_output_t *output)
+{
+	struct freemix_raw_video_rebind *rebind = param;
+	if ((output->info.flags & OBS_OUTPUT_ENCODED) || !(output->info.flags & OBS_OUTPUT_VIDEO) ||
+	    (!output->freemix_main_video_reset && (!rebind->old_video || output->video != rebind->old_video)) ||
+	    obs_output_active(output))
+		return true;
+	obs_output_t *held = obs_output_get_ref(output);
+	if (held) {
+		output->video = NULL;
+		output->freemix_main_video_reset = true;
+		da_push_back(rebind->outputs, &held);
+	}
+	return true;
+}
+
+static int freemix_rebind_raw_video(struct freemix_raw_video_rebind *rebind, int result)
+{
+	video_t *video = result == OBS_VIDEO_SUCCESS ? obs_get_video() : NULL;
+	pthread_mutex_lock(&obs->data.outputs_mutex);
+	for (size_t i = 0; i < rebind->outputs.num; i++) {
+		obs_output_t *output = rebind->outputs.array[i];
+		/* Do not overwrite a binding changed by a plugin during reset. */
+		if (output->freemix_main_video_reset && !output->video && !obs_output_active(output)) {
+			output->video = video;
+			if (video)
+				output->freemix_main_video_reset = false;
+		}
+	}
+	pthread_mutex_unlock(&obs->data.outputs_mutex);
+	for (size_t i = 0; i < rebind->outputs.num; i++)
+		obs_output_release(rebind->outputs.array[i]);
+	da_free(rebind->outputs);
+	return result;
+}
