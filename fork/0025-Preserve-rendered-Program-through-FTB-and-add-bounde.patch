+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <numeric>
+namespace freemix_call_video {
+struct FpsPlan{unsigned divisor=0;uint32_t numerator=0,denominator=0;};
+inline FpsPlan DeriveFps(uint32_t numerator,uint32_t denominator){
+ if(!numerator||!denominator)return {};auto gcd=std::gcd(numerator,denominator);numerator/=gcd;denominator/=gcd;
+ unsigned divisor=0;
+ if((denominator==1&&(numerator==25||numerator==30))||(denominator==1001&&numerator==30000))divisor=1;
+ if((denominator==1&&(numerator==50||numerator==60))||(denominator==1001&&numerator==60000))divisor=2;
+ if(!divisor)return {};return {divisor,numerator/divisor,denominator};
+}
+inline unsigned FpsDivisor(uint32_t numerator,uint32_t denominator){return DeriveFps(numerator,denominator).divisor;}
+inline const char *ActionGuard(const std::string &action,bool optIn,bool draining){
+ if(action=="state")return "";
+ if(action!="start"&&action!="stop"&&action!="pulse")return "Unknown action";
+ if(!optIn)return "Continuous video requires explicit experimental opt-in";
+ if(draining&&action!="stop")return "Context draining; no start or renewal";return "";
+}
+inline bool ParseToken(const char *hex,std::array<uint8_t,32> &out){
+ out.fill(0);if(!hex||std::strlen(hex)!=64)return false;
+ auto digit=[](char c){return c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:-1;};bool any=false;
+ for(int i=0;i<32;i++){int a=digit(hex[i*2]),b=digit(hex[i*2+1]);if(a<0||b<0){out.fill(0);return false;}out[i]=uint8_t(a*16+b);any|=out[i]!=0;}return any;
+}
+}
diff --git a/frontend/widgets/FreeMixCallVideoPool.hpp b/frontend/widgets/FreeMixCallVideoPool.hpp
new file mode 100644
index 0000000..986943d
--- /dev/null
+++ b/frontend/widgets/FreeMixCallVideoPool.hpp
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+// Own draft. No OBS/Qt dependency. Three fixed slots, one serialized producer.
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+
+namespace freemix_call_video {
+static_assert(std::atomic<uint32_t>::is_always_lock_free&&std::atomic<uint64_t>::is_always_lock_free,"Capture pool requires lock-free counters on this target");
+constexpr uint32_t Width=640,Height=360,Stride=Width*4,Payload=Stride*Height,HeaderSize=64;
+inline void Put16(uint8_t *p,uint16_t v){p[0]=uint8_t(v);p[1]=uint8_t(v>>8);}
+inline void Put32(uint8_t *p,uint32_t v){for(int i=0;i<4;i++)p[i]=uint8_t(v>>(i*8));}
+inline void Put64(uint8_t *p,uint64_t v){for(int i=0;i<8;i++)p[i]=uint8_t(v>>(i*8));}
+inline std::array<uint8_t,HeaderSize> Header(uint32_t slot,uint32_t generation,uint64_t sequence,uint64_t pts,uint32_t fpsNum=30,uint32_t fpsDen=1){
+ std::array<uint8_t,HeaderSize> h{};std::memcpy(h.data(),"FMVF",4);Put16(h.data()+4,1);Put16(h.data()+6,HeaderSize);
+ Put16(h.data()+8,Width);Put16(h.data()+10,Height);Put16(h.data()+12,1);Put32(h.data()+16,Stride);Put32(h.data()+20,Payload);
+ Put32(h.data()+24,slot);Put32(h.data()+28,generation);Put64(h.data()+32,sequence);Put64(h.data()+40,pts);Put32(h.data()+48,fpsNum);Put32(h.data()+52,fpsDen);return h;
+}
+class Pool {
+ enum State : uint32_t {Free,Writing,Ready,Reading};
+ struct Cell {std::atomic<uint32_t> state{Free};std::unique_ptr<uint8_t[]> rgba{new uint8_t[Payload]};std::atomic<uint64_t> sequence{0};uint64_t pts=0;};
+ std::array<Cell,3> cells;
+ uint64_t sequence=0,lastPts=0,callbacks=0;
+public:
+ struct Lease {int index=-1;const uint8_t *rgba=nullptr;uint64_t sequence=0,pts=0;};
+ std::atomic<bool> accepting{false};
+ std::atomic<uint64_t> captured{0},replaced{0},busyDropped{0},clockDropped{0},invalid{0},consumed{0};
+ unsigned divisor=1;uint32_t fpsNum=30,fpsDen=1; // Set while idle; derived actual rational, never relabel PTS.
+ bool Capture(const uint8_t *rgba,uint32_t stride,uint64_t pts) noexcept {
+  if(!accepting.load(std::memory_order_relaxed))return false;
+  if(!rgba||stride<Stride||!pts){invalid++;return false;}
+  if(++callbacks%divisor!=0)return false;
+  if(pts<=lastPts){clockDropped++;return false;}lastPts=pts;
+  int chosen=-1;
+  for(int i=0;i<3;i++){uint32_t expected=Free;if(cells[i].state.compare_exchange_strong(expected,Writing,std::memory_order_acquire)){chosen=i;break;}}
+  if(chosen<0)for(int i=0;i<3;i++){uint32_t expected=Ready;if(cells[i].state.compare_exchange_strong(expected,Writing,std::memory_order_acquire)){chosen=i;replaced++;break;}}
+  if(chosen<0){busyDropped++;return false;}
+  auto &cell=cells[chosen];
+  for(uint32_t y=0;y<Height;y++){auto *row=cell.rgba.get()+y*Stride;std::memcpy(row,rgba+uint64_t(y)*stride,Stride);for(uint32_t x=3;x<Stride;x+=4)row[x]=255;}
+  cell.sequence=++sequence;cell.pts=pts;captured++;cell.state.store(Ready,std::memory_order_release);return true;
+ }
+ Lease TakeLatest() noexcept {
+  Lease best;
+  for(int i=0;i<3;i++){
+   uint32_t expected=Ready;if(!cells[i].state.compare_exchange_strong(expected,Reading,std::memory_order_acquire))continue;
+   auto &cell=cells[i];
+   if(best.index<0||cell.sequence.load()>best.sequence){if(best.index>=0){cells[best.index].state.store(Free,std::memory_order_release);replaced++;}best={i,cell.rgba.get(),cell.sequence.load(),cell.pts};}
+   else {cell.state.store(Free,std::memory_order_release);replaced++;}
+  }
+  if(best.index>=0)consumed++;return best;
+ }
+ bool Release(Lease &lease) noexcept {
+  if(lease.index<0||lease.index>2||lease.rgba!=cells[lease.index].rgba.get()||lease.sequence!=cells[lease.index].sequence.load())return false;
+  uint32_t expected=Reading;if(!cells[lease.index].state.compare_exchange_strong(expected,Free,std::memory_order_release))return false;
+  lease={};return true;
+ }
+};
+} // namespace freemix_call_video
diff --git a/frontend/widgets/FreeMixFtbContract.hpp b/frontend/widgets/FreeMixFtbContract.hpp
new file mode 100644
index 0000000..3bee680
--- /dev/null
+++ b/frontend/widgets/FreeMixFtbContract.hpp
@@ -0,0 +1,70 @@
+// FreeMix FTB contract policy. No OBS/Qt/global state or I/O in this header.
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <deque>
+#include <string>
+#include <unordered_map>
+
+namespace freemix_ftb {
+struct Snapshot {
+ bool available=false, studio=false, closing=false, running=false, manual=false;
+ bool requested=false, blackObserved=false, normalObserved=false, restoreRemoved=false;
+ std::string scope, context, program, preview, output, restore;
+};
+struct Request {
+ bool active=false;
+ std::string id, connection, scope, context, program, preview, output;
+};
+enum class Kind { Reject, Start, Unchanged, Replayed };
+struct Decision { Kind kind=Kind::Reject; std::string error; };
+struct Receipt {
+ std::string signature, id, connection, expectedOutput, failure;
+ bool active=false, terminal=false;
+};
+inline bool Identifier(const std::string &s) {
+ if(s.empty()||s.size()>80)return false;
+ return std::all_of(s.begin(),s.end(),[](unsigned char c){return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='-';});
+}
+inline bool Uuid(const std::string &s) {
+ if(s.size()!=36)return false;
+ for(size_t n=0;n<s.size();++n){if(n==8||n==13||n==18||n==23){if(s[n]!='-')return false;}else if(!((s[n]>='0'&&s[n]<='9')||(s[n]>='a'&&s[n]<='f')||(s[n]>='A'&&s[n]<='F')))return false;}return true;
+}
+class Policy {
+ std::string seed=std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()), scope;
+ unsigned long long epoch=1;
+ std::unordered_map<std::string,Receipt> receipts;
+ std::deque<std::string> order;
+ static std::string Key(const Request &r){return r.connection+":"+r.id;}
+ static std::string Signature(const Request &r){return (r.active?"1|":"0|")+r.context+"|"+r.program+"|"+r.preview+"|"+r.output;}
+public:
+ void Reset(){++epoch;scope.clear();receipts.clear();order.clear();}
+ std::string Context(const std::string &currentScope){if(scope!=currentScope){++epoch;scope=currentScope;receipts.clear();order.clear();}return seed+":"+std::to_string(epoch);}
+ void Observe(const Snapshot &s){for(auto &entry:receipts){auto &r=entry.second;if(!r.terminal)r.terminal=r.active?s.blackObserved:(s.normalObserved&&s.output==r.expectedOutput);}}
+ Decision Check(const Request &r,const Snapshot &s)const {
+  const auto reject=[](const char *e){return Decision{Kind::Reject,e};};
+  if(!Identifier(r.id)||!Identifier(r.connection)||!Uuid(r.program)||!Uuid(r.preview))return reject("Identificação FTB ou UUID inválido.");
+  if(s.closing)return reject("O FreeMix está encerrando; nenhum FTB será enviado.");
+  if(r.scope!=s.scope||r.context!=s.context)return reject("Projeto ou contexto do motor mudou. Consulte FTB novamente.");
+  const auto old=receipts.find(Key(r));
+  if(old!=receipts.end()){if(old->second.signature!=Signature(r))return reject("ID FTB reutilizado para outro comando.");if(!old->second.failure.empty())return {Kind::Reject,old->second.failure};return {Kind::Replayed,{}};}
+  if(!s.studio)return reject("Ative o modo Preview/Programa para usar o FTB.");
+  if(!s.available)return reject("Não há quicktransition FTB nativa configurada. Nenhuma transição Fade comum será usada.");
+  if(r.output!=s.output)return reject("A saída renderizada do Programa mudou. Consulte o motor antes de enviar FTB.");
+  if(r.program!=s.program||r.preview!=s.preview)return reject("Programa ou Preview mudou. Consulte o motor antes de enviar FTB.");
+  if(s.running||s.manual)return reject("Uma transição de vídeo ou áudio está ativa. Aguarde terminar; o FTB não será repetido.");
+  if(s.restoreRemoved)return reject("A fonte de retorno do FTB foi removida. Confira o motor; nenhum retorno será inventado.");
+  if((s.requested&&!s.blackObserved)||(!s.requested&&!s.normalObserved))return reject("Estado FTB não confirmado. Confira o motor; nenhum toggle será enviado.");
+  if(receipts.size()>=128&&std::none_of(order.begin(),order.end(),[&](const auto &k){return receipts.at(k).terminal;}))return reject("Limite de comandos FTB sem confirmação. Confira o motor.");
+  if(r.active==s.requested)return {Kind::Unchanged,{}};
+  return {Kind::Start,{}};
+ }
+ void Accept(const Request &r,const Snapshot &before,bool unchanged){
+  if(receipts.size()>=128){const auto old=std::find_if(order.begin(),order.end(),[&](const auto &k){return receipts.at(k).terminal;});if(old!=order.end()){receipts.erase(*old);order.erase(old);}}
+  const auto key=Key(r);receipts.emplace(key,Receipt{Signature(r),r.id,r.connection,r.active?std::string{}:before.restore,{},r.active,unchanged});order.push_back(key);
+ }
+ void RejectAccepted(const Request &r,const std::string &failure){const auto i=receipts.find(Key(r));if(i!=receipts.end()){i->second.failure=failure;i->second.terminal=true;}}
+ const Receipt *Find(const Request &r)const{const auto i=receipts.find(Key(r));return i==receipts.end()?nullptr:&i->second;}
+ size_t Size()const{return receipts.size();}
+};
+} // namespace freemix_ftb
