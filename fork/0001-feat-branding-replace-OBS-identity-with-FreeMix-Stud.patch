From 4ffb4315026a20ec075dbf4fa45d385d15c679d0 Mon Sep 17 00:00:00 2001
From: Eddy Sangalli <eddyrodrigues@outlook.com>
Date: Wed, 7 Oct 2026 12:10:59 -0300
Subject: [PATCH 1/5] feat(branding): replace OBS identity with FreeMix Studio
 native branding and icons

---
 frontend/CMakeLists.txt               |   2 +-
 frontend/OBSApp.cpp                   |   2 +-
 frontend/cmake/ui-widgets.cmake       |   1 +
 frontend/cmake/windows/freemix.ico    | Bin 0 -> 51989 bytes
 frontend/cmake/windows/obs.rc.in      |  14 +++++++-------
 frontend/forms/OBSBasic.ui            |   2 +-
 frontend/forms/images/freemix.png     | Bin 0 -> 26373 bytes
 frontend/forms/obs.qrc                |   1 +
 frontend/widgets/OBSBasicStats.cpp    |   2 +-
 frontend/widgets/OBSBasic_Preview.cpp |   4 ++++
 frontend/widgets/OBSBasic_SysTray.cpp |   2 +-
 frontend/widgets/OBSProjector.cpp     |   2 +-
 12 files changed, 19 insertions(+), 13 deletions(-)
 create mode 100644 frontend/cmake/windows/freemix.ico
 create mode 100644 frontend/forms/images/freemix.png

diff --git a/frontend/CMakeLists.txt b/frontend/CMakeLists.txt
index f0cde6b..fb29270 100644
--- a/frontend/CMakeLists.txt
+++ b/frontend/CMakeLists.txt
@@ -112,4 +112,4 @@ source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" PREFIX "Source Files" FILES ${ta
 source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" PREFIX "Header Files" FILES ${target_hpp_sources})
 source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" PREFIX "Qt Files" FILES ${target_qt_sources})
 
-set_target_properties_obs(obs-studio PROPERTIES FOLDER frontend OUTPUT_NAME "$<IF:$<PLATFORM_ID:Windows>,obs64,obs>")
+set_target_properties_obs(obs-studio PROPERTIES FOLDER frontend OUTPUT_NAME "$<IF:$<PLATFORM_ID:Windows>,FreeMix,obs>")
diff --git a/frontend/OBSApp.cpp b/frontend/OBSApp.cpp
index 0d6d0e2..89f0f51 100644
--- a/frontend/OBSApp.cpp
+++ b/frontend/OBSApp.cpp
@@ -953,7 +953,7 @@ OBSApp::OBSApp(int &argc, char **argv, profiler_name_store_t *store)
 	sleepInhibitor = os_inhibit_sleep_create("OBS Video/audio");
 
 #ifndef __APPLE__
-	setWindowIcon(QIcon::fromTheme("obs", QIcon(":/res/images/obs.png")));
+	setWindowIcon(QIcon(":/res/images/freemix.png"));
 #endif
 
 	setDesktopFileName("com.obsproject.Studio");
diff --git a/frontend/cmake/ui-widgets.cmake b/frontend/cmake/ui-widgets.cmake
index dd60fbe..b264254 100644
--- a/frontend/cmake/ui-widgets.cmake
+++ b/frontend/cmake/ui-widgets.cmake
@@ -26,6 +26,7 @@ target_sources(
     widgets/OBSBasic_Icons.cpp
     widgets/OBSBasic_MainControls.cpp
     widgets/OBSBasic_OutputHandler.cpp
+    widgets/FreeMixSafeArea.cpp
     widgets/OBSBasic_Preview.cpp
     widgets/OBSBasic_Profiles.cpp
     widgets/OBSBasic_Projectors.cpp
diff --git a/frontend/cmake/windows/freemix.ico b/frontend/cmake/windows/freemix.ico
new file mode 100644
index 0000000000000000000000000000000000000000..eb3eb445f04dca11c3ebc02cfeff62b600b43c64
