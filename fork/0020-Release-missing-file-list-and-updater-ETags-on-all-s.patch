From 6cbf07641c501cb6b319c6bf7000b805fdce625c Mon Sep 17 00:00:00 2001
From: Eddy Sangalli <eddyrodrigues@outlook.com>
Date: Fri, 9 Oct 2026 20:21:12 -0300
Subject: [PATCH] Release missing-file list and updater ETags on all shutdown
 paths

---
 frontend/widgets/OBSBasic_SceneCollections.cpp  | 2 ++
 shared/file-updater/file-updater/file-updater.c | 9 ++++-----
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/frontend/widgets/OBSBasic_SceneCollections.cpp b/frontend/widgets/OBSBasic_SceneCollections.cpp
index ea1bb04..b599bde 100644
--- a/frontend/widgets/OBSBasic_SceneCollections.cpp
+++ b/frontend/widgets/OBSBasic_SceneCollections.cpp
@@ -1510,6 +1510,8 @@ retryScene:
 
 	if (!App()->IsMissingFilesCheckDisabled()) {
 		ShowMissingFilesDialog(files);
+	} else {
+		obs_missing_files_destroy(files);
 	}
 
 	disableSaving--;
diff --git a/shared/file-updater/file-updater/file-updater.c b/shared/file-updater/file-updater/file-updater.c
index 1f3deb0..6d00f64 100644
--- a/shared/file-updater/file-updater/file-updater.c
+++ b/shared/file-updater/file-updater/file-updater.c
@@ -46,6 +46,9 @@ void update_info_destroy(struct update_info *info)
 	if (info->thread_created)
 		pthread_join(info->thread, NULL);
 
+	bfree(info->etag_local);
+	bfree(info->etag_remote);
+
 	da_free(info->file_data);
 	bfree(info->log_prefix);
 	bfree(info->user_agent);
@@ -96,6 +99,7 @@ static size_t http_header(char *buffer, size_t size, size_t nitems, void *info_p
 			if (p)
 				*p = 0;
 
+			bfree(info->etag_remote);
 			info->etag_remote = etag_clean;
 		}
 	}
@@ -444,11 +448,6 @@ static void *update_thread(void *data)
 	update_remote_version(info, cur_version);
 	os_rmdir(info->temp);
 
-	if (info->etag_local)
-		bfree(info->etag_local);
-	if (info->etag_remote)
-		bfree(info->etag_remote);
-
 	return NULL;
 }
 
-- 
2.56.0.windows.1

