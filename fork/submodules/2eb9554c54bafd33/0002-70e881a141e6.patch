From 70e881a141e6533e34e56923f0da095cd87e7839 Mon Sep 17 00:00:00 2001
From: Eddy Sangalli <eddyrodrigues@outlook.com>
Date: Sat, 10 Oct 2026 08:47:58 -0300
Subject: [PATCH] Initialize meter state and serialize mute reads with captured
 levels

---
 src/utils/Obs_VolumeMeter.cpp | 12 ++++++++++--
 src/utils/Obs_VolumeMeter.h   |  8 ++++----
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/utils/Obs_VolumeMeter.cpp b/src/utils/Obs_VolumeMeter.cpp
index df614e0..bb9f8f1 100644
--- a/src/utils/Obs_VolumeMeter.cpp
+++ b/src/utils/Obs_VolumeMeter.cpp
@@ -75,9 +75,8 @@ json Utils::Obs::VolumeMeter::Meter::GetMeterData()
 	}
 
 	std::vector<std::vector<float>> levels;
-	const float volume = _muted ? 0.0f : _volume.load();
-
 	std::unique_lock<std::mutex> l(_mutex);
+	const float volume = _muted ? 0.0f : _volume.load();
 
 	if (_lastUpdate != 0 && (os_gettime_ns() - _lastUpdate) * 0.000000001 > 0.3)
 		ResetAudioLevels();
@@ -106,6 +105,7 @@ void Utils::Obs::VolumeMeter::Meter::ResetAudioLevels()
 	for (int channelNumber = 0; channelNumber < MAX_AUDIO_CHANNELS; channelNumber++) {
 		_magnitude[channelNumber] = 0;
 		_peak[channelNumber] = 0;
+		std::fill_n(_previousSamples[channelNumber], 4, 0.0f);
 	}
 }
 
@@ -129,6 +129,10 @@ void Utils::Obs::VolumeMeter::Meter::ProcessAudioChannels(const struct audio_dat
 void Utils::Obs::VolumeMeter::Meter::ProcessPeak(const struct audio_data *data)
 {
 	size_t sampleCount = data->frames;
+	if (sampleCount == 0) {
+		ResetAudioLevels();
+		return;
+	}
 	int channelNumber = 0;
 
 	for (int planeNumber = 0; channelNumber < _channels; planeNumber++) {
@@ -196,6 +200,10 @@ void Utils::Obs::VolumeMeter::Meter::ProcessPeak(const struct audio_data *data)
 void Utils::Obs::VolumeMeter::Meter::ProcessMagnitude(const struct audio_data *data)
 {
 	size_t sampleCount = data->frames;
+	if (sampleCount == 0) {
+		ResetAudioLevels();
+		return;
+	}
 
 	int channelNumber = 0;
 	for (int planeNumber = 0; channelNumber < _channels; planeNumber++) {
diff --git a/src/utils/Obs_VolumeMeter.h b/src/utils/Obs_VolumeMeter.h
index 48a0a2f..eaf9204 100644
--- a/src/utils/Obs_VolumeMeter.h
+++ b/src/utils/Obs_VolumeMeter.h
@@ -51,11 +51,11 @@ namespace Utils {
 
 				// All values in mul
 				std::mutex _mutex;
-				bool _muted;
+				bool _muted = false;
 				int _channels;
-				float _magnitude[MAX_AUDIO_CHANNELS];
-				float _peak[MAX_AUDIO_CHANNELS];
-				float _previousSamples[MAX_AUDIO_CHANNELS][4];
+				float _magnitude[MAX_AUDIO_CHANNELS] = {};
+				float _peak[MAX_AUDIO_CHANNELS] = {};
+				float _previousSamples[MAX_AUDIO_CHANNELS][4] = {};
 
 				std::atomic<uint64_t> _lastUpdate;
 				std::atomic<float> _volume;
