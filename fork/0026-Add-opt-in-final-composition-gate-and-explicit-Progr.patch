+#pragma once
+#include "obs-final-gate.h"
+/* Render-thread owned, zero initialized on every video-mix allocation. */
+struct obs_final_gate_runtime {
+ uint32_t identity, generation, applied_serial, frame_seq;
+ bool master, follows_master, enabled, requested_active, running, clock_fault;
+ uint32_t parent_identity;
+ double gain, from_gain, to_gain;
+ uint64_t start_pts_ns, last_pts_ns, duration_ns;
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+uint32_t obs_final_gate_new_identity(void);
+void obs_final_gate_invalidate_identity(uint32_t identity);
+void obs_final_gate_prepare(struct obs_final_gate_runtime *r, bool master, uint64_t pts_ns);
+void obs_final_gate_inherit(struct obs_final_gate_runtime *r, const struct obs_final_gate_runtime *master, uint64_t pts_ns);
+void obs_final_gate_finish_inherited(struct obs_final_gate_runtime *r, bool draw_applied);
+bool obs_final_gate_reuse_blocked(const struct obs_final_gate_runtime *r);
+void obs_final_gate_publish(struct obs_final_gate_runtime *r, uint64_t pts_ns, bool draw_applied);
+#ifdef __cplusplus
+}
+#endif
diff --git a/libobs/obs-final-gate-render.h b/libobs/obs-final-gate-render.h
new file mode 100644
index 0000000..026452d
--- /dev/null
+++ b/libobs/obs-final-gate-render.h
@@ -0,0 +1,20 @@
+/* Included only by obs-video.c, after composition and rendered callbacks, before conversion. */
+static inline bool draw_master_final_gate(struct obs_core_video_mix *video)
+{
+ const struct obs_final_gate_runtime *gate=&video->final_gate;
+ if((!gate->master&&!gate->follows_master)||!gate->enabled||gate->gain>=1.0)return true;
+ gs_effect_t *effect=obs->video.solid_effect;
+ if(!effect)return false;
+ gs_eparam_t *color=gs_effect_get_param_by_name(effect,"color");
+ if(!color)return false;
+ struct vec4 black;vec4_set(&black,0.0f,0.0f,0.0f,(float)(1.0-gate->gain));
+ gs_effect_set_vec4(color,&black);
+ gs_set_render_target_with_color_space(video->render_texture,NULL,video->render_space);
+ set_render_size(video->ovi.base_width,video->ovi.base_height);
+ gs_blend_state_push();gs_enable_blending(true);
+ gs_blend_function_separate(GS_BLEND_ONE,GS_BLEND_INVSRCALPHA,GS_BLEND_ONE,GS_BLEND_INVSRCALPHA);
+ bool drawn=false;
+ while(gs_effect_loop(effect,"Solid")){gs_draw_sprite(NULL,0,video->ovi.base_width,video->ovi.base_height);drawn=true;}
+ gs_blend_state_pop();
+ return drawn;
+}
diff --git a/libobs/obs-final-gate.h b/libobs/obs-final-gate.h
new file mode 100644
index 0000000..fd51300
--- /dev/null
+++ b/libobs/obs-final-gate.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include "util/c99defs.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Experimental main-video final stage. Audio and independent video are unchanged. */
+struct obs_master_final_gate_state {
+ uint32_t contract_version, mix_identity, generation, command_serial;
+ bool available, enabled, requested_active, running, black_observed, normal_observed, clock_fault;
+ uint32_t gain_q24, frame_seq;
+ uint64_t frame_pts_ns;
+};
+struct obs_master_final_gate_request {
