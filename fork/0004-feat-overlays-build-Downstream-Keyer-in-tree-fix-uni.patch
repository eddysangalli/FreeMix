+		obs_data_set_string(response_data, "error", "'dsk_name' not set");
+		obs_data_set_bool(response_data, "success", false);
+		return;
+	}
+	QString dskName = QString::fromUtf8(dsk_name);
+	const int count = dsk->tabs->count();
+	for (int i = 0; i < count; i++) {
