import {execFileSync} from 'node:child_process';
const normal=s=>String(s).normalize('NFKC').trim().toLowerCase();let installed;
export function installedGtFonts(){if(installed)return installed;installed=new Set(['arial','sans-serif','serif','monospace']);if(process.platform!=='win32')return installed;for(const key of ['HKLM','HKCU'])try{const lines=execFileSync('reg.exe',['query',key+'\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'],{windowsHide:true,encoding:'utf8',maxBuffer:1024*1024}).split(/\r?\n/);for(const line of lines){const m=/^\s*(.+?)\s+REG_SZ\s+/.exec(line);if(m){const name=m[1].replace(/\s*\([^)]*\)\s*$/,'');installed.add(normal(name));installed.add(normal(name.replace(/\s+(?:regular|bold|italic|semibold|light|medium|black)(?:\s+italic)?$/i,'')));}}}catch{}return installed;}
export function fontDiagnostics(objects,embedded=[]){const available=installedGtFonts(),provided=new Set(embedded.map(f=>normal(f.family)));return [...new Set([...objects].filter(o=>o.fontFamily).map(o=>o.fontFamily))].map(family=>({family,status:provided.has(normal(family))?'explicit-import':available.has(normal(family))?'installed-local':'missing',fallback:'Arial, sans-serif',automaticDownload:false}));}
export function sfntFamily(bytes){
 if(bytes.length<12||bytes.length>2*1024*1024)return null;const magic=bytes.toString('ascii',0,4);if(!['OTTO','true'].includes(magic)&&bytes.readUInt32BE(0)!==0x00010000)return null;const count=bytes.readUInt16BE(4);if(count>512||12+count*16>bytes.length)return null;
 for(let i=0;i<count;i++){const p=12+i*16;if(bytes.toString('ascii',p,p+4)!=='name')continue;const start=bytes.readUInt32BE(p+8),length=bytes.readUInt32BE(p+12);if(start+length>bytes.length||length<6)return null;const n=bytes.readUInt16BE(start+2),strings=bytes.readUInt16BE(start+4);if(6+n*12>length)return null;let family=null;for(let j=0;j<n;j++){const r=start+6+j*12,platform=bytes.readUInt16BE(r),id=bytes.readUInt16BE(r+6),len=bytes.readUInt16BE(r+8),offset=bytes.readUInt16BE(r+10);if(![1,16].includes(id)||strings+offset+len>length)continue;const raw=Buffer.from(bytes.subarray(start+strings+offset,start+strings+offset+len));const value=platform===0||platform===3?(len%2?null:raw.swap16().toString('utf16le')):raw.toString('latin1');if(value&&/^[\p{L}\p{N} _-]{1,80}$/u.test(value)){family=value;if(id===16||platform===3)return family;}}return family;}return null;
}
