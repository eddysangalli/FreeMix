import path from 'node:path';
import {gtObjects} from './gtzip-xml.mjs';
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const json=v=>JSON.stringify(v).replaceAll('<','\\u003c');
const family=v=>String(v||'Arial').replace(/[^\p{L}\p{N} _-]/gu,' ').trim()||'Arial';
const asset=(source,map)=>{const key=String(source||'').replaceAll('\\','/');return map[key]||map[path.posix.basename(key)]||'';};
const safeUrl=v=>String(v||'').split('/').map(x=>encodeURIComponent(x).replace(/[!'()*]/g,c=>'%'+c.charCodeAt(0).toString(16))).join('/');
function fill(brush){if(!brush||brush.type==='Bitmap')return 'transparent';if(brush.type==='Solid')return brush.color;const angle=Math.atan2(brush.endPoint[1]-brush.startPoint[1],brush.endPoint[0]-brush.startPoint[0])*180/Math.PI+90,stops=brush.stops.map(s=>s.color+' '+s.position*100+'%');return stops.length?'linear-gradient('+angle+'deg,'+stops.join(',')+')':'transparent';}
function hidden(a,w,h){const direction=a.direction||'Left',axis=['Left','Right'].includes(direction)?'X':'Y',sign=['Right','Bottom'].includes(direction)?1:-1;if(a.type==='Fade')return {opacity:0};if(a.type==='Hidden')return {opacity:0};if(a.type==='Fly')return {opacity:0,transform:'translate'+axis+'('+(sign*(axis==='X'?w:h))+'px)'};if(['Zoom','ZoomFade'].includes(a.type))return {opacity:a.type==='ZoomFade'?0:1,transform:'scale('+a.scale+')'};if(a.type==='Rotate')return {opacity:0,transform:'rotate('+a.angle+'deg)'};if(a.type==='Expand')return {transform:direction==='Center'?'scale'+(a.centerAxis==='Y'?'Y':'X')+'(0)':'scale'+axis+'(0)'};if(a.type==='Reveal')return {clipPath:direction==='Center'?(a.centerAxis==='Y'?'inset(50% 0 50% 0)':'inset(0 50% 0 50%)'):{Left:'inset(0 100% 0 0)',Right:'inset(0 0 0 100%)',Top:'inset(0 0 100% 0)',Bottom:'inset(100% 0 0 0)'}[direction]||'inset(0 100% 0 0)'};return null;}
export function generateHtml(data,title='FreeMix GT Template',assets={},options={}){
 const {width,height,storyboards}=data,fields=[...gtObjects(data)].filter(e=>['TextBlock','Ticker','Image','QRCode'].includes(e.type)).map(e=>({id:e.name,label:e.name,type:e.type==='Image'?'image':e.type==='Ticker'?'ticker':e.type==='QRCode'?'qrcode':'text',default:e.text??asset(e.source,assets),path:e.path})),animations=[],warnings=data.warnings||(data.warnings=[]);let serial=0;
 const missing=(e,source)=>{const message=e.name+': recurso ausente ('+source+') ['+e.path+']';if(!warnings.includes(message))warnings.push(message);};
 function object(e){const id='gt-'+serial++,base=['position:absolute','left:'+e.x+'px','top:'+e.y+'px','width:'+e.width+'px','height:'+e.height+'px',e.visible?'':'display:none'].filter(Boolean).join(';'),transforms='translate('+e.translate.join('px,')+'px) rotate('+e.rotation+'deg) scale('+e.scale.join(',')+')',style=['width:100%','height:100%','position:relative','opacity:'+e.opacity,'transform:'+transforms,'transform-origin:'+e.origin.map(x=>x*100+'%').join(' ')];
  if(e.crop)style.push('clip-path:inset('+[e.crop[1],1-e.crop[2],1-e.crop[3],e.crop[0]].map(n=>n*100+'%').join(' ')+')');let content='';
  if(e.elements){content=(e.order||[...e.elements,...e.children]).map(object).join('');}
  else if(e.type==='Rectangle'){style.push('background:'+fill(e.fill),'border-radius:'+e.radiusX+'px / '+e.radiusY+'px');if(e.fill?.type==='Bitmap'){const url=asset(e.fill.source,assets);if(url)style.push('background-image:url('+safeUrl(url)+')','background-size:100% 100%');else missing(e,e.fill.source);}if(e.strokeThickness)style.push('border:'+e.strokeThickness+'px solid '+fill(e.stroke));}
  else if(['Ellipse','Triangle','RightTriangle','Polygon','Path'].includes(e.type)){const shape=e.type==='Ellipse'?'<ellipse cx="'+e.width/2+'" cy="'+e.height/2+'" rx="'+e.width/2+'" ry="'+e.height/2+'"/>':e.type==='Path'?'<path d="'+esc(e.geometry)+'"/>':'<polygon points="'+esc(e.geometry)+'"/>';let svgFill=e.fill?.type==='Solid'?e.fill.color:'transparent',defs='';if(e.fill?.type==='LinearGradient'){svgFill='url(#gradient-'+id+')';defs='<defs><linearGradient id="gradient-'+id+'" x1="'+e.fill.startPoint[0]+'" y1="'+e.fill.startPoint[1]+'" x2="'+e.fill.endPoint[0]+'" y2="'+e.fill.endPoint[1]+'">'+e.fill.stops.map(s=>'<stop offset="'+s.position+'" stop-color="'+esc(s.color)+'"/>').join('')+'</linearGradient></defs>';}else if(e.fill?.type==='Bitmap'){const url=asset(e.fill.source,assets);if(url){svgFill='url(#pattern-'+id+')';defs='<defs><pattern id="pattern-'+id+'" patternUnits="objectBoundingBox" width="1" height="1"><image href="'+esc(safeUrl(url))+'" width="'+e.width+'" height="'+e.height+'"/></pattern></defs>';}else missing(e,e.fill.source);}content='<svg width="100%" height="100%" viewBox="0 0 '+e.width+' '+e.height+'" style="overflow:visible">'+defs+'<g fill="'+esc(svgFill)+'" stroke="'+esc(e.stroke?.type==='Solid'?e.stroke.color:'transparent')+'" stroke-width="'+e.strokeThickness+'">'+shape+'</g></svg>';}
  else if(e.type==='QRCode'){style.push('overflow:hidden');}
  else if(e.type==='Image'){const url=asset(e.source,assets);if(url)style.push('background-image:url('+safeUrl(url)+')','background-size:'+(e.sizeMode==='Stretch'?'100% 100%':e.sizeMode==='UniformToFill'?'cover':'contain'),'background-position:center','background-repeat:no-repeat');else missing(e,e.source);}
  else if(['TextBlock','Ticker'].includes(e.type)){style.push('display:flex','align-items:'+({top:'flex-start',bottom:'flex-end'}[e.verticalAlign]||'center'),'justify-content:'+({left:'flex-start',right:'flex-end'}[e.textAlign]||'center'),'font-family:"'+family(e.fontFamily)+'",Arial,sans-serif','font-size:'+e.fontSize+'px','font-weight:'+e.fontWeight,'font-style:'+e.fontStyle,'color:'+fill(e.fill),'white-space:'+(e.wordWrap?'normal':'nowrap'),'overflow:hidden');if(e.strokeThickness)style.push('-webkit-text-stroke:'+e.strokeThickness+'px '+fill(e.stroke));content=esc(e.text);if(e.type==='Ticker'){const vertical=['Top','Bottom'].includes(e.direction);content='<span class="gt-ticker-content" style="display:inline-block;white-space:nowrap;animation:ticker-'+(vertical?'vertical':'horizontal')+' '+Math.max(1,60/e.speed)+'s linear infinite'+(['Right','Bottom'].includes(e.direction)?' reverse':'')+'">'+esc(e.text)+'</span>';}}
  for(const sb of storyboards)for(const a of sb.animations.filter(a=>a.target===e.name)){const from=hidden(a,width,height);if(from)animations.push({id,phase:sb.type,from,to:{opacity:1,transform:'none',clipPath:'inset(0 0 0 0)'},duration:a.duration*1000,delay:a.delay*1000,origin:({Left:'left center',Right:'right center',Top:'center top',Bottom:'center bottom'}[a.direction]||'center'),easing:({Linear:'linear',CubicEasingIn:'cubic-bezier(.55,.055,.675,.19)',CubicEasingOut:'cubic-bezier(.215,.61,.355,1)',CubicEasingInOut:'cubic-bezier(.645,.045,.355,1)'}[a.interpolation]||'ease')});}
  return '<div id="'+id+'" class="gt-motion '+(e.elements?'gt-layer':'gt-object')+'" data-name="'+esc(e.name)+'" data-xml-path="'+esc(e.path)+'" style="'+esc(base)+'"><div class="gt-content '+(e.type==='TextBlock'?'gt-text':e.type==='Image'?'gt-image':e.type==='Ticker'?'gt-ticker-wrapper':e.type==='QRCode'?'gt-qrcode':'')+'"'+(['TextBlock','Image','Ticker','QRCode'].includes(e.type)?' data-field-name="'+esc(e.name)+'"':'')+(e.type==='QRCode'?' data-qr-width="'+e.width+'" data-qr-height="'+e.height+'" data-qr-unsupported="'+esc(e.qrUnsupported||'')+'"':'')+' style="'+esc(style.join(';'))+'">'+content+'</div></div>';
 }
 const markup=data.layers.map(object).join(''),fonts=options.fontFaces||[],fontRules=fonts.map(f=>'@font-face{font-family:"'+family(f.family)+'";src:url("'+safeUrl(f.url)+'");font-display:swap;}').join('\n');
 return `<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=${width},height=${height},initial-scale=1"><title>${esc(title)}</title><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline' file: http://127.0.0.1:* http://localhost:*; style-src 'unsafe-inline'; img-src 'self' file: data: blob:; font-src 'self' file: data:; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"><style>*{box-sizing:border-box;margin:0;padding:0}html,body,#gc-root{width:${width}px;height:${height}px;overflow:hidden;background:transparent}#gc-root{position:relative;transform-origin:top left;visibility:hidden}@keyframes ticker-horizontal{from{transform:translateX(${width}px)}to{transform:translateX(-100%)}}@keyframes ticker-vertical{from{transform:translateY(${height}px)}to{transform:translateY(-100%)}}${fontRules}</style></head><body><div id="gc-root">${markup}</div>${fields.some(f=>f.type==='qrcode')?'<script src="./gt-qr.js"></script>':''}<script>
const specs=${json(animations)},fields=${json(fields)},assetMap=${json(assets)};let active=[],timeline={};
function animate(phase){for(const a of active)a.cancel();active=[];document.getElementById('gc-root').style.visibility='visible';for(const a of specs.filter(s=>s.phase===phase)){const el=document.getElementById(a.id);if(!el)continue;el.style.transformOrigin=a.origin;const frames=phase==='TransitionOut'?[a.to,a.from]:[a.from,a.to],animation=el.animate(frames,{duration:a.duration,delay:a.delay,easing:a.easing,fill:'both'});active.push(animation);}if(phase==='TransitionIn'&&Number.isFinite(timeline.animationStartedAt)&&timeline.animationStartedAt>0){const elapsed=Math.max(0,Date.now()-timeline.animationStartedAt);for(const a of active)a.currentTime=elapsed;}if(phase==='TransitionOut'){const end=Math.max(0,...specs.filter(a=>a.phase===phase).map(a=>a.duration+a.delay));Promise.all(active.map(a=>a.finished.catch(()=>null))).then(()=>{if(active.every(a=>a.playState==='finished'))document.getElementById('gc-root').style.visibility='hidden';});if(!active.length)document.getElementById('gc-root').style.visibility='hidden';}}
function update(data){if(!data||typeof data!=='object')return;for(const el of document.querySelectorAll('[data-field-name]')){const key=el.dataset.fieldName;if(!Object.hasOwn(data,key))continue;const val=String(data[key]??'');if(el.classList.contains('gt-qrcode')){if(window.FreeMixGtQr)window.FreeMixGtQr.render(el,val);else{el.replaceChildren();el.dataset.qrError='QR: encoder local indisponível';}}else if(el.classList.contains('gt-image')){const raw=assetMap[val]||val;if(!raw||raw.split('/').some(p=>p==='..')||/^(?:https?:|javascript:)/i.test(raw))continue;el.style.backgroundImage=['url','(',JSON.stringify(raw),')'].join('');}else if(el.classList.contains('gt-ticker-wrapper'))el.querySelector('.gt-ticker-content').textContent=val;else el.textContent=val;}}
window.FreeMixTitle={data:fields,updateFields:update,transitionIn(){animate('TransitionIn')},transitionOut(){animate('TransitionOut')},warnings:${json(warnings)}};window.FreeMixGCCompatibility={version:1,animation:true,clock:false,style:false};window.GC={configure(t){timeline=t||{}},play(d){update(d);animate('TransitionIn')},stop(){animate('TransitionOut')},update};window.addEventListener('message',e=>{if(e.source!==window.parent||!e.data)return;if(e.data.action==='UPDATE_FIELDS')update(e.data.payload);if(e.data.action==='TRANSITION_IN')animate('TransitionIn');if(e.data.action==='TRANSITION_OUT')animate('TransitionOut')});
update(Object.fromEntries(fields.filter(f=>f.type==='qrcode').map(f=>[f.id,f.default])));
const clockFormats=new Map(fields.filter(f=>f.type!=='qrcode'&&/^\{0:(?:HH|hh):mm(?::ss)?(?: tt)?\}$/.test(f.default)).map(f=>[f.id,f.default.slice(3,-1)]));function tickClocks(){const now=new Date();for(const [name,format]of clockFormats){const hour=format.includes('hh')?(now.getHours()%12||12):now.getHours(),text=format.replace(/HH|hh/g,String(hour).padStart(2,'0')).replace('mm',String(now.getMinutes()).padStart(2,'0')).replace('ss',String(now.getSeconds()).padStart(2,'0')).replace('tt',now.getHours()<12?'AM':'PM');for(const el of document.querySelectorAll('[data-field-name]'))if(el.dataset.fieldName===name&&!el.classList.contains('gt-qrcode'))el.textContent=text;}}if(clockFormats.size){tickClocks();setInterval(tickClocks,1000);}
</script><script src="./gc.js"></script></body></html>`;
}
