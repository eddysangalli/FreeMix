import {readFile,stat} from 'node:fs/promises';
import {createReadStream} from 'node:fs';
import {join,isAbsolute,dirname} from 'node:path';
import {pathToFileURL} from 'node:url';
import {randomUUID,createHash} from 'node:crypto';
import {inspectGtzipFile,convertGtzipFile} from './gtzip_converter.mjs';
import {noGtLinks,safeGtPath} from './gtzip-archive.mjs';
import {validateGtQrField} from './gtzip-qr.mjs';
import {validateGCAssets} from './gc-assets.mjs';
const uuid=/^[a-f0-9-]{36}$/i;
export function importedGtPath(panel,id){if(!uuid.test(id))throw Error('ID GTZIP inválido');const file=join(panel,'gc/gt_titles','gt_'+id,'index.html');noGtLinks(file);return file;}
export async function verifyImportedGtTitle(panel,record){const folder=dirname(importedGtPath(panel,record.id)),file=join(folder,'manifest.json');noGtLinks(file);const info=await stat(file);if(info.size>8*1024*1024||!/^[a-f0-9]{64}$/.test(record.manifestSha256||''))throw Error('Título sem recibo de integridade válido; importe uma cópia nova');const raw=await readFile(file);if(createHash('sha256').update(raw).digest('hex')!==record.manifestSha256)throw Error('Manifesto do título alterado; original mantido');const m=JSON.parse(raw);if(m.format!==2||!Array.isArray(m.files)||m.files.length>4096)throw Error('Manifesto do título inválido');let total=0;const names=new Set();for(const f of m.files){safeGtPath(f.path);if(names.has(f.path.toLowerCase())||!Number.isSafeInteger(f.size)||f.size<0||f.size>64*1024*1024||!/^[a-f0-9]{64}$/.test(f.sha256))throw Error('Registro de arquivo do título inválido');names.add(f.path.toLowerCase());total+=f.size;if(total>256*1024*1024)throw Error('Título excede 256 MB');const target=join(folder,f.path);noGtLinks(target);const actual=await stat(target);if(!actual.isFile()||actual.size!==f.size)throw Error('Arquivo do título alterado: '+f.path);const hash=createHash('sha256');for await(const b of createReadStream(target))hash.update(b);if(hash.digest('hex')!==f.sha256)throw Error('Arquivo do título alterado: '+f.path);}if(!names.has('index.html'))throw Error('Entrada HTML não registrada');return m;}
function validateQrValues(manifest,values){
 for(const field of manifest.fields.filter(f=>f.type==='QRCode')){
  const value=Object.hasOwn(values,field.name)?values[field.name]:field.default,qr=field.qr;
  const error=!qr?'QR: contrato ausente; importe novamente':qr.unsupported||validateGtQrField(value,qr.width,qr.height);
  if(error)throw Error('Campo QR inválido: '+field.name+' — '+error);
 }
}
export function normalizeGtRecord(record){if(!record||!uuid.test(record.id)||typeof record.name!=='string'||!record.name.trim()||record.name.length>100||!record.resolution||!Number.isFinite(record.resolution.width)||!Number.isFinite(record.resolution.height)||record.resolution.width<16||record.resolution.height<16||record.resolution.width>8192||record.resolution.height>8192)throw Error('Registro GTZIP inválido');if(!Array.isArray(record.fields)||record.fields.length>500)throw Error('Campos GTZIP inválidos');return {...record,values:record.values||{}};}
export async function executeGtImport(engine,payload){
 const p=engine.p,operation=payload.operation||'preview';if(!['preview','import','save','prepare'].includes(operation))throw Error('Operação GTZIP inválida');
 if(['preview','import'].includes(operation)){
  const file=String(payload.sourcePath||'');if(!isAbsolute(file)||!file.toLowerCase().endsWith('.gtzip'))throw Error('Informe um caminho absoluto de arquivo .gtzip');const options={includeFonts:payload.includeFonts===true},preview=inspectGtzipFile(file,options);if(operation==='preview')return preview;
  if(!payload.expectedSha256||payload.expectedSha256!==preview.sourceSha256)throw Error('Confira a prévia atual antes de importar o GTZIP');if(engine.imports.length>=200)throw Error('Limite de 200 títulos importados');const id=randomUUID(),name=String(payload.name||preview.manifest.title).trim();if(!name||name.length>100||/[\x00-\x1f]/.test(name))throw Error('Nome: use 1 a 100 caracteres');
  const converted=convertGtzipFile(file,join(p.panel,'gc/gt_titles'),{...options,expectedSha256:payload.expectedSha256,folderName:'gt_'+id}),m=converted.manifest,record={id,name,sourceSha256:m.sourceSha256,manifestSha256:converted.manifestSha256,resolution:m.resolution,fields:m.fields,values:{},warnings:m.warnings,fonts:m.fonts,createdAt:Date.now()};const before=engine.imports;engine.imports=[...before,record];try{await engine.save();}catch(e){engine.imports=before;throw Error('Título convertido foi preservado, mas o registro na biblioteca falhou: '+e.message);}return {imported:true,id,name,entrypoint:importedGtPath(p.panel,id),warnings:m.warnings,fonts:m.fonts,appStarted:false,scenesCreated:false,outputsStarted:false};
 }
 const record=engine.imports.find(r=>r.id===payload.id);if(!record)throw Error('Título importado não encontrado nesta produção');const file=importedGtPath(p.panel,record.id);const verifiedManifest=await verifyImportedGtTitle(p.panel,record);
 if(operation==='save'){
  const values=payload.values;if(!values||typeof values!=='object'||Array.isArray(values))throw Error('Campos inválidos');const fields=new Map(record.fields.map(f=>[f.name,f])),normalized={};for(const [key,value]of Object.entries(values)){const field=fields.get(key);if(!field||typeof value!=='string'||value.length>2000||/[\x00-\x08\x0b\x0c\x0e-\x1f]/.test(value))throw Error('Campo do título inválido: '+key);if(field.type==='Image'&&value.startsWith('library:')){const token=value.slice(8);await validateGCAssets(p.panel,{imageAsset:token});normalized[key]=pathToFileURL(join(p.panel,'gc/biblioteca/assets',token)).href;}else if(field.type==='Image'&&value){const manifest=JSON.parse(await readFile(join(file,'../manifest.json'),'utf8'));if(!manifest.resources.includes(value))throw Error('Imagem deve ser um recurso do título ou um asset importado');normalized[key]=value;}else normalized[key]=value;}
  validateQrValues(verifiedManifest,normalized);
  const before=record.values;record.values=Object.fromEntries(Object.entries(normalized).map(([k,v])=>{if(v.startsWith('file:')){const original=values[k];if(original.startsWith('library:'))return [k,original];}return [k,v];}));try{await engine.save();}catch(e){record.values=before;throw e;}return {saved:true,id:record.id,scenesCreated:false,outputsStarted:false};
 }
 validateQrValues(verifiedManifest,record.values);
 const scene='FreeMix GT '+record.id,input=scene+' HTML';if(p.state.overlays?.some(o=>o.scene===scene)||p.state.program===scene)throw Error('Retire o título do ar antes de preparar novamente');const runtimeValues={...record.values};for(const f of record.fields.filter(f=>f.type==='Image')){const v=runtimeValues[f.name];if(v?.startsWith('library:')){const token=v.slice(8);await validateGCAssets(p.panel,{imageAsset:token});runtimeValues[f.name]=pathToFileURL(join(p.panel,'gc/biblioteca/assets',token)).href;}}const url=pathToFileURL(file).href+'#'+encodeURIComponent(JSON.stringify({n:input,d:runtimeValues})),list=await p.req('GetSceneList');if(!list.scenes.some(s=>s.sceneName===scene))await p.req('CreateScene',{sceneName:scene});const settings=await p.optional('GetInputSettings',{inputName:input});if(settings&&settings.inputKind!=='browser_source')throw Error('Fonte importada existente não é navegador');const resolution=record.resolution;if(settings)await p.req('SetInputSettings',{inputName:input,inputSettings:{url,...resolution}});else{const created=await p.req('CreateInput',{sceneName:scene,inputName:input,inputKind:'browser_source',inputSettings:{url,...resolution,shutdown:false,restart_when_active:false},sceneItemEnabled:true});const video=await p.req('GetVideoSettings');await p.req('SetSceneItemTransform',{sceneName:scene,sceneItemId:created.sceneItemId,sceneItemTransform:{positionX:0,positionY:0,boundsType:'OBS_BOUNDS_SCALE_INNER',boundsWidth:video.baseWidth,boundsHeight:video.baseHeight,boundsAlignment:0}});}await p.refresh();return {prepared:true,id:record.id,scene,input,...resolution,outputsStarted:false};
}
