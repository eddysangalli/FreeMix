import {parseAttributes,convertColor} from './gt_utils.mjs';
import {validateGtQr,validateGtQrField} from './gtzip-qr.mjs';
export function parseGtTree(xml){
 if(typeof xml!=='string'||xml.length>8*1024*1024||/<!DOCTYPE|<!ENTITY/i.test(xml))throw Error('XML excessivo ou DTD/entidades externas não permitidas');const document={tag:'#document',attrs:{},children:[],text:'',path:''},stack=[document],counts=new WeakMap();let cursor=0,nodes=0;
 const tokens=/<\?[^?]*\?>|<!--[\s\S]*?-->|<!\[CDATA\[[\s\S]*?\]\]>|<\/?[A-Za-z_][\w.:-]*(?:\s+(?:"[^"]*"|'[^']*'|[^'">])*)?\s*\/?>/g;let match;
 while((match=tokens.exec(xml))){const between=xml.slice(cursor,match.index);if(between.includes('<'))throw Error('XML malformado');stack.at(-1).text+=between;cursor=tokens.lastIndex;const token=match[0];if(token.startsWith('<?')||token.startsWith('<!--'))continue;if(token.startsWith('<![CDATA[')){stack.at(-1).text+=token.slice(9,-3);continue;}const close=token.startsWith('</'),tag=/^<\/?([\w.:-]+)/.exec(token)[1];if(close){if(stack.length===1||stack.at(-1).tag!==tag)throw Error('XML com fechamento divergente: '+tag);stack.pop();continue;}
  const parent=stack.at(-1),seen=counts.get(parent)||{},number=(seen[tag]||0)+1;seen[tag]=number;counts.set(parent,seen);const attrs=parseAttributes(token),node={tag,attrs,ownerName:attrs.Name||attrs.Object||parent.ownerName||'',children:[],text:'',path:parent.path+'/'+tag+'['+number+']'};parent.children.push(node);if(++nodes>50000||stack.length>64)throw Error('XML com nós/profundidade excessivos');if(!token.endsWith('/>'))stack.push(node);
 }
 if(stack.length!==1||xml.slice(cursor).trim()||document.text.trim()||document.children.length!==1)throw Error('XML incompleto ou múltiplas raízes');return document.children[0];
}
export function* walkGtTree(node){yield node;for(const child of node.children)yield* walkGtTree(child);}
export function* gtObjects(data){function* group(layer){yield layer;for(const el of layer.elements)yield el;for(const child of layer.children||[])yield* group(child);}for(const l of data.layers)yield* group(l);}
const number=(value,fallback,min=-1e6,max=1e6)=>value===undefined?fallback:Math.max(min,Math.min(max,Number.isFinite(Number(value))?Number(value):fallback));
const coords=(value,defaults)=>String(value||'').split(',').map((v,i)=>number(v.trim()===''?undefined:v,defaults[i]||0));
function vector(value,defaults){const c=coords(value,defaults);return defaults.map((v,i)=>c[i]===undefined?v:c[i]);}
const child=(node,tag)=>node.children.find(n=>n.tag===tag),descendant=(node,tag)=>[...walkGtTree(node)].find(n=>n.tag===tag);
function brush(node,property,warn){const container=child(node,node.tag+'.'+property),b=container&&descendant(container,'Brush');if(!b)return {type:'Solid',color:property==='Stroke'?'transparent':'rgba(255,255,255,1)'};const a=b.attrs,type=a.Type||'Solid',color=(value,n=b)=>{if(!/^#(?:[a-f0-9]{6}|[a-f0-9]{8})$/i.test(value||'')){warn(n,'Cor inválida; usado transparente');return 'transparent';}return convertColor(value);};if(type==='Transparent')return {type:'Solid',color:'transparent'};if(['Solid','SolidColor'].includes(type))return {type:'Solid',color:color(a.Color||'#FFFFFFFF')};if(type==='LinearGradient')return {type,startPoint:vector(a.StartPoint,[0,0]),endPoint:vector(a.EndPoint,[0,1]),stops:[...walkGtTree(b)].filter(n=>n.tag==='GradientStop').map(n=>({position:number(n.attrs.Position,0,0,1),color:color(n.attrs.Color||a.Color||'#FFFFFFFF',n)})).sort((x,y)=>x.position-y.position)};if(type==='Bitmap')return {type,source:descendant(b,'Bitmap')?.attrs.Source||''};warn(b,'Brush não convertido: '+type);return {type:'Solid',color:'transparent'};}
export function parseGtXml(xml){
 const tree=parseGtTree(xml);if(tree.tag!=='Composition')throw Error('Raiz Composition não encontrada');const width=number(tree.attrs.Width,1920),height=number(tree.attrs.Height,1080);if(width<16||height<16||width>8192||height>8192)throw Error('Dimensões do título fora de 16 a 8192 pixels');const warnings=[],diagnostics=[],seenNames=new Set();
 const warn=(n,message)=>{const w={code:'GT_UNSUPPORTED',name:n.attrs.Name||n.attrs.Object||n.ownerName||'',path:n.path,message};diagnostics.push(w);warnings.push((w.name?w.name+': ':'')+message+' ['+w.path+']');};
 const known=new Set(['Composition','Layer','Group','Rectangle','Ellipse','Triangle','RightTriangle','Polygon','Path','TextBlock','Ticker','Image','QRCode','Brush','GradientStop','Bitmap','Transform','Crop','Effect','Storyboard','None','Fade','Fly','Zoom','Rotate','Reveal','Expand','ZoomFade','Hidden']);
 for(const n of walkGtTree(tree)){if(n.tag.includes('.'))continue;if(!known.has(n.tag))warn(n,'Elemento/animação não convertido: '+n.tag);if(n.tag==='Effect')warn(n,'Efeito não convertido: '+n.attrs.Type);if(['Mesh','Video','Shader','Particle'].includes(n.tag))continue;}
 const storyboards=[...walkGtTree(tree)].filter(n=>n.tag==='Storyboard').map(n=>({type:n.attrs.Type||'TransitionIn',animations:[...walkGtTree(n)].filter(a=>a.attrs.Object&&known.has(a.tag)).map(a=>({type:a.tag,target:a.attrs.Object,delay:number(a.attrs.Delay,0,0,30),duration:number(a.attrs.Duration,.5,0,30),scale:number(a.attrs.Scale,.01,.001,10),angle:number(a.attrs.Angle,90,-3600,3600),direction:a.attrs.Direction||'Left',centerAxis:a.attrs.CenterAxis||'X',interpolation:a.attrs.Interpolation||'CubicEasingIn',path:a.path}))}));
 function object(node){const a=node.attrs,d=vector(a.Dimensions,[100,100,0]),loc=vector(a.Location,[0,0,0]),name=a.Name||node.tag+'_'+node.path.replace(/\W/g,'_');if(seenNames.has(name))warn(node,'Nome duplicado; edição atualizará todos os campos com esse nome');seenNames.add(name);const el={type:node.tag,name,path:node.path,x:loc[0],y:loc[1],width:number(d[0],100,0,8192),height:number(d[1],100,0,8192),visible:a.Visible!=='False',opacity:number(a.Opacity,1,0,1),fill:brush(node,'Fill',warn),stroke:brush(node,'Stroke',warn),strokeThickness:number(a.StrokeThickness,0,0,100)};
  if(loc[2]||d[2])warn(node,'Dimensão/posição Z ignorada; renderização somente 2D');const t=child(node,node.tag+'.Transform')?.children.find(c=>c.tag==='Transform')||child(node,'Transform');const rotation=vector(t?.attrs.Rotate||a.Rotate,[0,0,0]);if(rotation[0]||rotation[1])warn(t||node,'Rotação 3D X/Y não convertida');el.rotation=rotation[2]*180/Math.PI;el.scale=vector(t?.attrs.Scale||a.Scale,[1,1,1]).slice(0,2);el.translate=vector(t?.attrs.Translate,[0,0,0]).slice(0,2);el.origin=vector(t?.attrs.Origin,[.5,.5]).slice(0,2);
  const crop=child(node,node.tag+'.Crop')?.children.find(c=>c.tag==='Crop');if(crop){el.crop=vector(crop.attrs.Range,[0,0,1,1]).map(v=>number(v,0,0,1));if(vector(crop.attrs.Feather,[0,0,0,0]).some(Boolean))warn(crop,'Crop com feather não convertido');}
  if(node.tag==='Rectangle'){const r=vector(a.Radius,[0,0]);el.radiusX=r[0];el.radiusY=r[1];}
  if(['Triangle','RightTriangle','Polygon','Path'].includes(node.tag)){el.geometry=node.tag==='Triangle'?`${el.width/2},0 ${el.width},${el.height} 0,${el.height}`:node.tag==='RightTriangle'?`0,0 ${el.width},${el.height} 0,${el.height}`:a.Points||a.Data||'';if(node.tag==='Polygon'&&!/^[\d.,eE+\-\s]+$/.test(el.geometry)||node.tag==='Path'&&(!el.geometry||!/^[MLCQAZHTVSmlcqazhtvs\d.,eE+\-\s]+$/.test(el.geometry)))warn(node,'Geometria SVG ausente ou incompatível');}
  if(['TextBlock','Ticker'].includes(node.tag)){const tb=node.tag==='Ticker'?descendant(child(node,'Ticker.Template')||node,'TextBlock'):null,ta=tb?.attrs||{};Object.assign(el,{text:a.Text??ta.Text??'',fontFamily:a.FontFamily||ta.FontFamily||'Arial',fontSize:number(a.FontSize||ta.FontSize,36,1,1000),fontWeight:/^(?:bold|semibold|heavy)$/i.test(a.FontWeight||ta.FontWeight||'')?'bold':'normal',fontStyle:/^(?:italic|oblique)$/i.test(a.FontStyle||ta.FontStyle||'')?'italic':'normal',textAlign:(a.TextAlign||ta.TextAlign||'Left').toLowerCase(),verticalAlign:(a.VerticalAlign||ta.VerticalAlign||'Center').toLowerCase(),wordWrap:(a.TextWordWrapping||ta.TextWordWrapping)==='Wrap',speed:number(a.Speed,4,.01,100),direction:a.Direction||'Left'});}
  if(node.tag==='Ticker'&&child(node,'Ticker.Template')&&[...walkGtTree(child(node,'Ticker.Template'))].some(n=>['Layer','Group','Image'].includes(n.tag)))warn(node,'Ticker.Template complexo não convertido; somente texto com rolagem aproximada');
  if(node.tag==='QRCode'){
   el.text=a.Text??'';
   const allowed=new Set(['Name','Dimensions','Location','Text','Visible','Opacity','Rotate','Scale']);
   const unsupported=Object.keys(a).filter(key=>!allowed.has(key));
   const unsupportedChildren=node.children.filter(c=>!['QRCode.Transform','QRCode.Crop','Transform'].includes(c.tag));
   if(unsupported.length||unsupportedChildren.length)el.qrUnsupported='QR: opções/filhos fora do contrato Text, ECC M e quiet-zone4';
   if(!a.Dimensions||!/^\s*\d+(?:\.\d+)?\s*,\s*\d+(?:\.\d+)?(?:\s*,\s*0(?:\.0+)?)?\s*$/.test(a.Dimensions))el.qrUnsupported='QR: Dimensions explícitas são necessárias';
   const dimensionsError=validateGtQr('x',el.width,el.height);if(dimensionsError)el.qrUnsupported=dimensionsError;
   const error=el.qrUnsupported||validateGtQrField(el.text,el.width,el.height);if(error)warn(node,error);
  }
  if(node.tag==='Image'){el.source=descendant(child(node,'Image.Bitmap')||node,'Bitmap')?.attrs.Source||'';el.sizeMode=a.SizeMode||'Stretch';}
  return el;
 }
 function group(node){const layer=object(node);layer.width=vector(node.attrs.Dimensions,[width,height,0])[0];layer.height=vector(node.attrs.Dimensions,[width,height,0])[1];layer.elements=[];layer.children=[];layer.order=[];let content=node.children;if(child(node,node.tag+'.Composition'))content=child(node,node.tag+'.Composition').children.flatMap(c=>c.tag==='Composition'?c.children:[c]);for(const n of content){if(['Layer','Group'].includes(n.tag)){const g=group(n);layer.children.push(g);layer.order.push(g);}else if(['Rectangle','Ellipse','Triangle','RightTriangle','Polygon','Path','Image','TextBlock','Ticker','QRCode'].includes(n.tag)){const e=object(n);layer.elements.push(e);layer.order.push(e);}else if(n.tag==='Composition'){const g=group({...n,tag:'Group',attrs:{...n.attrs,Name:n.attrs.Name||'Composition_'+n.path}});layer.children.push(g);layer.order.push(g);}}return layer;}
 const layers=tree.children.filter(n=>['Layer','Group'].includes(n.tag)).map(group);const direct=tree.children.filter(n=>['Rectangle','Image','TextBlock','Ellipse','Triangle','RightTriangle','Polygon','Path','Ticker','QRCode'].includes(n.tag));if(direct.length)layers.push(group({tag:'Group',path:tree.path+'/Direct',attrs:{Name:'Direct',Dimensions:width+','+height+',0'},children:direct}));
 for(const s of storyboards)for(const a of s.animations)if(!seenNames.has(a.target))warn({attrs:{Object:a.target},path:a.path},'Alvo de animação ausente');return {width,height,layers,storyboards,warnings,diagnostics};
}
