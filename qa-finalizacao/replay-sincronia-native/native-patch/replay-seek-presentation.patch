diff --git a/freemix-app/shared/media-playback/media-playback/media.c b/freemix-app/shared/media-playback/media-playback/media.c
--- a/freemix-app/shared/media-playback/media-playback/media.c
+++ b/freemix-app/shared/media-playback/media-playback/media.c
@@ -585,7 +585,18 @@ static void seek_to(mp_media_t *m, int64_t pos)
 			if ((skip_video && m->v.eof) || (skip_audio && m->a.eof))
 				break;
 		}
-		if (m->has_video && m->pause && m->v_preload_cb && m->v.frame_ready)
+		/* A seek is a new presentation timeline. Keeping the old origin makes
+		 * the decoder cursor jump while OBS still presents queued old images.
+		 * Re-anchor audio and video together to the current wall clock. */
+		if (m->v.frame_ready || m->a.frame_ready) {
+			m->base_ts = 0;
+			m->play_sys_ts = (int64_t)os_gettime_ns();
+			m->start_ts = m->next_pts_ns = mp_media_get_next_min_pts(m);
+			m->next_ns = 0;
+		}
+		/* Publish the selected image immediately for paused AND playing seeks.
+		 * This does not consume it; the regular playback callback follows. */
+		if (m->has_video && m->v_seek_cb && m->v.frame_ready)
 			mp_media_next_video(m, true);
 		if (!m->has_video && m->has_audio && m->pause && m->a.frame_ready)
 			remember_presented_pts(m, m->a.frame_pts);
@@ -770,7 +781,13 @@ static bool init_avformat(mp_media_t *m)
 
 static void reset_ts(mp_media_t *m)
 {
-	m->base_ts += mp_media_get_base_pts(m);
+	/* Local resume must not add the absolute clip position to presentation
+	 * time. At 50% that delays the first image even with matching cursors.
+	 * Preserve the upstream streaming clock path. */
+	if (m->is_local_file)
+		m->base_ts = 0;
+	else
+		m->base_ts += mp_media_get_base_pts(m);
 	m->play_sys_ts = (int64_t)os_gettime_ns();
 	m->start_ts = m->next_pts_ns = mp_media_get_next_min_pts(m);
 	m->next_ns = 0;
@@ -1047,12 +1064,12 @@ void mp_media_stop(mp_media_t *m)
 
 int64_t mp_media_get_current_time(mp_media_t *m)
 {
-	/* Decoder next_pts can be a frame or an audio packet ahead of the paused
-	 * image. Report submitted video PTS or the audio-only packet start when
-	 * paused; retain the playback clock while playing. Callback PTS uses the
-	 * existing speed-scaled nanosecond timeline, hence the same conversion. */
+	/* Report submitted video PTS in both states. Decoder next_pts can be
+	 * ahead of the displayed image and is not a confirmation of a seek.
+	 * Audio-only sources use their submitted packet start. Callback PTS uses
+	 * the speed-scaled timeline, hence the same conversion. */
 	pthread_mutex_lock(&m->mutex);
-	bool presented = m->pause && m->presented_valid;
+	bool presented = m->presented_valid;
 	int64_t pts = m->presented_pts;
 	pthread_mutex_unlock(&m->mutex);
 	if (presented)
diff --git a/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c b/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c
--- a/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c
+++ b/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c
@@ -259,6 +259,9 @@ static void preload_frame(void *opaque, struct obs_source_frame *f)
 static void seek_frame(void *opaque, struct obs_source_frame *f)
 {
 	struct ffmpeg_source *s = opaque;
+	/* Drop only old seek-timeline images before publishing the selected one.
+	 * Otherwise normal async playback can retain frames from before seek. */
+	obs_source_output_video(s->source, NULL);
 	obs_source_set_video_frame(s->source, f);
 }
 
