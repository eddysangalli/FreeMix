diff --git a/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c b/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c
--- a/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c
+++ b/freemix-app/plugins/obs-ffmpeg/obs-ffmpeg-source.c
@@ -714,7 +714,9 @@ static void ffmpeg_source_restart(void *data)
 {
 	struct ffmpeg_source *s = data;
 
-	if (obs_source_showing(s->source))
+	/* A file kept open while hidden must also accept an explicit restart.
+	 * Replay cues off-air players after EOF without changing Programme. */
+	if (obs_source_showing(s->source) || !s->close_when_inactive)
 		ffmpeg_source_start(s);
 
 	set_media_state(s, OBS_MEDIA_STATE_PLAYING);
