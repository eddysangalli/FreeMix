+#include <QFileInfo>
+#include <QCryptographicHash>
+#ifdef Q_OS_WIN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace freemix_distro {
+// Windows customer builds use the licensed SDK already present in the approved
+// FreeMix payload, never a vendor install or an environment-variable path.
+inline QString ManagedNdiPath(const QString &applicationDirectory)
+{
+	QDir root(applicationDirectory);
+	if (!root.cdUp() || !root.cdUp()) return {};
+	const QString file = root.absoluteFilePath("runtime/ndi-v6/Processing.NDI.Lib.x64.dll");
+	for (QString p=file;;) {
+		const QFileInfo info(p);
+		if (info.isSymLink() || info.isJunction()) return {};
+		const QString parent=info.dir().absolutePath();
+		if (parent==p) break;
+		p=parent;
+	}
+	const QFileInfo info(file);
+	if (!info.isFile() || info.size()!=29863120) return {};
+#ifdef Q_OS_WIN
+	const HANDLE handle=CreateFileW(reinterpret_cast<LPCWSTR>(file.utf16()), FILE_READ_ATTRIBUTES,
+		FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+		FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+	if (handle==INVALID_HANDLE_VALUE) return {};
+	BY_HANDLE_FILE_INFORMATION metadata{};
+	const bool independent=GetFileInformationByHandle(handle,&metadata) &&
+		metadata.nNumberOfLinks==1 && !(metadata.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT);
+	CloseHandle(handle);
+	if (!independent) return {};
+#endif
+	QFile sdk(file);
+	if (!sdk.open(QIODevice::ReadOnly)) return {};
+	QCryptographicHash hash(QCryptographicHash::Sha256);
+	if (!hash.addData(&sdk)) return {};
+	if (hash.result().toHex()!="2b6602075868ba4401f82f417d72424805d69b11ca86078023d0d489ff45dd84") return {};
+	return file;
+}
+} // namespace freemix_distro
