diff --git a/lib/utils/managed-backup.hpp b/lib/utils/managed-backup.hpp
new file mode 100644
--- /dev/null
+++ b/lib/utils/managed-backup.hpp
@@ -0,0 +1,33 @@
+#pragma once
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QSaveFile>
+
+namespace advss {
+// An immutable, atomic copy of the original settings. Never replace an existing
+// different backup and never follow a link in its directory chain.
+inline bool StoreMigrationSnapshot(const QString &path, const QByteArray &snapshot)
+{
+	if (snapshot.isEmpty()) return false;
+	const QFileInfo info(path);
+	if (info.isSymLink() || info.isJunction()) return false;
+	QString parent = info.absolutePath();
+	while (true) {
+		const QFileInfo parentInfo(parent);
+		if (parentInfo.isSymLink() || parentInfo.isJunction()) return false;
+		const QString next = parentInfo.dir().absolutePath();
+		if (next == parent) break;
+		parent = next;
+	}
+	QDir dir(info.absolutePath());
+	if (!dir.exists() && !dir.mkpath(".")) return false;
+	if (info.exists()) {
+		QFile existing(path);
+		return existing.open(QIODevice::ReadOnly) && existing.readAll() == snapshot;
+	}
+	QSaveFile file(path);
+	file.setDirectWriteFallback(false);
+	return file.open(QIODevice::WriteOnly) && file.write(snapshot) == snapshot.size() && file.commit();
+}
+} // namespace advss
