IDI_ICON1 ICON DISCARDABLE "cmake/windows/freemix.ico"

1 VERSIONINFO
FILEVERSION ${OBS_VERSION_MAJOR},${OBS_VERSION_MINOR},${OBS_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FreeMix"
      VALUE "FileDescription", "FreeMix Studio"
      VALUE "FileVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "InternalName", "FreeMix"
      VALUE "OriginalFilename", "FreeMix.exe"
      VALUE "ProductName", "FreeMix Studio"
      VALUE "ProductVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "Comments", "Live production software built on OBS Studio, free and open source software (GPL-2.0-or-later)"
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
