  "probeEdits": [
    {
      "before": "import{PageTimestampOrigin}from'./page-timestamp-origin.mjs';",
      "after": "import{MutedReceiverAttachment}from'./muted-receiver-attachment.mjs';\nimport{PageTimestampOrigin}from'./page-timestamp-origin.mjs';"
    },
    {
      "before": "let statsTimer,statsPending=false,statsTask=null,localMeter,localSource,localGain;const trackCleanups=[];",
      "after": "let statsTimer,statsPending=false,statsTask=null,localMeter,localSource,localGain;const trackCleanups=[];\n const attachment=new MutedReceiverAttachment({element:el('video'),enabled:true});report.mutedConsumer={enabled:true,singleVariable:'SAME_REMOTE_AUDIO_TRACK_IN_EXISTING_MUTED_VIDEO_STREAM',causeProven:false,snapshots:[],truncated:0,faults:[],closed:false};\n const attachmentSnapshot=event=>{const v=el('video'),s=v.srcObject,a=s?.getAudioTracks?.()||[],row={event,atMs:performance.now(),muted:v.muted,paused:v.paused,readyState:v.readyState,networkState:v.networkState,currentTime:Number.isFinite(v.currentTime)?v.currentTime:null,videoTracks:s?.getVideoTracks?.().length||0,audioTracks:a.length,sameReceivedTrack:!!firstAudioTrack&&a.length===1&&a[0]===firstAudioTrack,metrics:{...attachment.metrics}};if(report.mutedConsumer.snapshots.length<32)report.mutedConsumer.snapshots.push(row);else report.mutedConsumer.truncated++;if(v.muted!==true)throw Error('OWN_ELEMENT_MUST_STAY_MUTED');};\n const attachObserved=event=>{try{if(event==='video-track')attachment.videoReady();else attachment.audio(firstAudioTrack);attachmentSnapshot(event);}catch(e){if(report.mutedConsumer.faults.length<8)report.mutedConsumer.faults.push({event,code:String(e.message).slice(0,100)});fault='MUTED_CONSUMER_ATTACHMENT_FAILED';}};"
    },
    {
      "before": "ctx=new AudioContext({sampleRate:RATE,latencyHint:",
      "after": "live={attachment};ctx=new AudioContext({sampleRate:RATE,latencyHint:"
    },
    {
      "before": "live={ctx};",
      "after": "live={ctx,attachment};"
    },
    {
      "before": "el('video').srcObject=new MediaStream([e.track]);el('video').play()",
      "after": "el('video').srcObject=new MediaStream([e.track]);attachObserved('video-track');el('video').play()"
    },
    {
      "before": "firstAudioTrack=e.track;watchTrack('received-audio',e.track);",
      "after": "firstAudioTrack=e.track;attachObserved('audio-track');watchTrack('received-audio',e.track);"
    },
    {
      "before": "statsPending=true;try{const out=",
      "after": "statsPending=true;try{attachmentSnapshot('rtp-tick');const out="
    },
    {
      "before": "clock?.close();timestampOrigin?.close();videoSink?.close();",
      "after": "try{attachmentSnapshot('before-close');}catch{fault='MUTED_CONSUMER_MUTE_GUARD';}attachment.close();report.mutedConsumer.closed=attachment.closed;try{attachmentSnapshot('after-close');}catch{}clock?.close();timestampOrigin?.close();videoSink?.close();"
    },
    {
      "before": "pageTimestampOrigin:!timestampOrigin||timestampOrigin.closed};",
      "after": "pageTimestampOrigin:!timestampOrigin||timestampOrigin.closed,mutedConsumer:attachment.closed};"
    },
    {
      "before": "window.addEventListener('pagehide',()=>{live?.clock?.close();",
      "after": "window.addEventListener('pagehide',()=>{live?.attachment?.close();live?.clock?.close();"
    }
